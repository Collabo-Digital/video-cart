## ✅ Required Practices

### 1. JSDoc Comments

**ALWAYS add JSDoc to exported functions:**

```javascript
/**
 * Description of what function does
 * @param {Type} param - Description
 * @returns {Promise<Type>} Description
 * @throws {ErrorClass} When condition
 */
export async function functionName(param) {
  // Implementation
}
```

### 2. Error Handling

**Routes MUST have try/catch:**

```javascript
export const action = async ({ request }) => {
  try {
    const result = await service();
    return json({ success: true, data: result });
  } catch (error) {
    console.error('Action failed:', error);
    return json({
      success: false,
      error: error.message,
      code: error.code,
    }, { status: error.statusCode || 500 });
  }
};
```

**Services MUST throw custom errors:**

```javascript
import { VideoError } from '~/lib/errors/VideoError';

export async function uploadVideo(data) {
  if (!data.file) {
    throw new VideoError('File required', 'FILE_REQUIRED');
  }
  // Process...
}
```

### 3. Validation

**Validate ALL inputs:**

```javascript
// In services
export async function createVideo(data) {
  if (!data.title) {
    throw new VideoError('Title required', 'TITLE_REQUIRED');
  }
  
  if (data.size > MAX_SIZE) {
    throw new VideoError('File too large', 'FILE_TOO_LARGE');
  }
  
  return VideoModel.create(data);
}
```

### 4. Constants

**Use constants, NOT magic values:**

```javascript
// ❌ BAD
if (file.size > 524288000) { ... }

// ✅ GOOD
import { VIDEO_CONFIG } from '~/lib/constants/video';
if (file.size > VIDEO_CONFIG.MAX_SIZE_BYTES) { ... }
```

### 5. Imports Organization

**Order imports consistently:**

```javascript
// 1. External libraries
import { useState } from 'react';
import { Button } from '@shopify/polaris';

// 2. Config
import { authenticate } from '~/config/shopify.server';

// 3. Models
import * as VideoModel from '~/models/video.server';

// 4. Services
import { uploadVideo } from '~/services/video/upload.service';

// 5. Utils & Constants
import { formatDate } from '~/lib/utils/dates';
import { VIDEO_CONFIG } from '~/lib/constants/video';

// 6. Styles
import styles from './styles.module.css';
```

---

## 🚫 Forbidden Patterns

### NEVER Do This

```javascript
// ❌ Business logic in route
export const action = async ({ request }) => {
  const body = await request.json();
  
  // ❌ DON'T: Business logic here
  if (body.size > 500 * 1024 * 1024) {
    return new Response(
      JSON.stringify({ error: 'Too large' }),
      {
        status: 400,
        headers: {
          'Content-Type': 'application/json',
        },
      }
    );
  }
  
  // ❌ DON'T: Direct Prisma in route
  const video = await prisma.video.create({ data: body });
  return new Response(
    JSON.stringify(video),
    {
      status: 200,
      headers: {
        'Content-Type': 'application/json',
      },
    }
  );
};

// ❌ Direct Prisma in service
export async function uploadVideo(data) {
  // ❌ DON'T: Use Prisma in service
  return prisma.video.create({ data });
}

// ❌ Business logic in model
export async function create(data) {
  // ❌ DON'T: Validation in model
  if (!data.title) throw new Error('Title required');
  
  // ❌ DON'T: External API call in model
  await fetch('https://api.example.com');
  
  return prisma.video.create({ data });
}

// ❌ Magic values
const MAX_SIZE = 500; // ❌ Should be in constants
if (size > 500) { } // ❌ Should use constant
```

### DO This Instead

```javascript
// ✅ Route (thin controller)
export const action = async ({ request }) => {
  try {
    const body = await request.json();
    const result = await uploadVideo(body); // Call service
    return new Response(
      JSON.stringify({ success: true, data: result }),
      {
        status: 200,
        headers: {
          'Content-Type': 'application/json',
        },
      }
    );
  } catch (error) {
    console.error('Upload failed:', error);
    return new Response(
      JSON.stringify({ error: error.message }),
      {
        status: 500,
        headers: {
          'Content-Type': 'application/json',
        },
      }
    );
  }
};

// ✅ Service (business logic)
export async function uploadVideo(data) {
  // Validation
  validateVideoFile(data.file);
  
  // Business logic
  const muxAsset = await uploadToMux(data.file);
  
  // Data operation
  return VideoModel.create({ ...muxAsset, ...data });
}

// ✅ Model (data access only)
export async function create(data) {
  return prisma.video.create({ data });
}

// ✅ Constants
import { VIDEO_CONFIG } from '~/lib/constants/video';
if (size > VIDEO_CONFIG.MAX_SIZE_BYTES) { }
```

