{% schema %}
{
  "name": "Video Cart",
  "target": "section",
  "settings": [
    { "type": "header", "content": "Advanced" },
    {
      "type": "text",
      "id": "feed_id",
      "label": "Feed ID override",
      "info": "Leave blank. Pick a feed from the dropdown in the block instead. Filling this in pins one exact feed and ignores the dropdown."
    }
  ]
}
{% endschema %}

{% assign store_page = 'other' %}
{% if template.name == 'index' %}
  {% assign store_page = 'homePage' %}
{% elsif template.name == 'product' %}
  {% assign store_page = 'productPage' %}
{% elsif template.name == 'collection' %}
  {% assign store_page = 'collectionPage' %}
{% endif %}


{% comment %}
  Theme editor only: pick a feed and it saves immediately.

  A theme block setting cannot be written by JavaScript — the schema is static
  and the theme-editor channel is one-directional — so the choice is stored
  against block.id in the app instead of in the theme. That is what removes the
  copy-the-id step.
{% endcomment %}
{% if request.design_mode %}
  <div class="video-feed-selector" style="padding: 16px; background: #f6f6f7; border: 1px dashed #d1d5db; border-radius: 8px; margin-bottom: 16px;">
    <label for="feed-search-{{ block.id }}" style="display: block; font-size: 13px; font-weight: 600; color: #202223; margin-bottom: 8px;">Select video feed</label>
    <div id="feed-combo-{{ block.id }}" style="position: relative;">
      <input id="feed-search-{{ block.id }}" type="text" autocomplete="off" spellcheck="false"
             role="combobox" aria-expanded="false" aria-autocomplete="list"
             aria-controls="feed-list-{{ block.id }}" placeholder="Search or choose a feed…"
             style="width: 100%; box-sizing: border-box; padding: 9px 32px 9px 12px; border: 1px solid #8a8a8a; border-radius: 8px; font-size: 14px; line-height: 20px; color: #202223; background: white; outline: none;" />
      <span aria-hidden="true" id="feed-caret-{{ block.id }}"
            style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none; color: #6d7175; font-size: 11px;">▼</span>
      <ul id="feed-list-{{ block.id }}" role="listbox" hidden
          style="position: absolute; z-index: 30; top: calc(100% + 4px); left: 0; right: 0; max-height: 240px; overflow-y: auto; margin: 0; padding: 4px; list-style: none; background: white; border: 1px solid #d1d5db; border-radius: 8px; box-shadow: 0 4px 16px rgba(0,0,0,0.12);"></ul>
    </div>
    <p id="feed-hint-{{ block.id }}" style="margin: 8px 0 0; font-size: 12px; color: #6d7175;">Choose a feed, then click Save in the theme editor.</p>
  </div>

  <script>
  (function() {
    var blockId = '{{ block.id }}';
    var shop = '{{ shop.permanent_domain }}';
    var hasOverride = '{{ block.settings.feed_id }}'.trim() !== '';
    var combo = document.getElementById('feed-combo-' + blockId);
    var listEl = document.getElementById('feed-list-' + blockId);
    var caret = document.getElementById('feed-caret-' + blockId);
    var searchInput = document.getElementById('feed-search-' + blockId);
    var hint = document.getElementById('feed-hint-' + blockId);
    var listEndpoint = '{{ routes.root_url }}apps/video-widget/feeds/list';
    var PAGE_SIZE = 5;
    var SEARCH_SIZE = 20;
    var searchTimer = null;
    var searchSeq = 0;
    var current = null;
    var options = [];
    var activeIndex = -1;
    var isOpen = false;
    var assignEndpoint = '{{ routes.root_url }}apps/video-widget/blocks/assign';
    var resolveEndpoint = '{{ routes.root_url }}apps/video-widget/blocks/resolve';

    // initFeeds() skips containers already marked initialized and reuses a feed
    // cached by containerId, so both have to be cleared or the preview keeps
    // showing the feed that was there before.
    function remountPreview() {
      var cfg = window.__video_cart_config__;
      var container = document.querySelector('[data-block-id="' + blockId + '"]');
      if (!cfg || typeof cfg.initFeeds !== 'function' || !container) return;
      delete container.dataset.videoCartInitialized;
      cfg.widgets = (cfg.widgets || []).filter(function(entry) {
        return entry.containerId !== container.dataset.containerId;
      });
      cfg.initFeeds();
    }

    function saveSelection(feedId) {
      hint.textContent = 'Saving…';
      fetch(assignEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ blockId: blockId, feedId: feedId })
      })
        .then(function(r) { return r.json(); })
        .then(function(result) {
          if (!result.success) throw new Error(result.error || 'Save failed');
          hint.textContent = hasOverride
            ? 'Saved, but a Feed ID override is set under Advanced — clear it for this to take effect.'
            : 'Saved "' + result.feedName + '". Click Save to keep this block on the page.';
          remountPreview();
        })
        .catch(function(err) {
          hint.textContent = 'Could not save: ' + err.message;
        });
    }

    // Preselect whatever this block is already showing. /blocks/resolve returns
    // the full payload, so the name is known without a second lookup — which
    // matters when the chosen feed is not in the first page.
    function loadCurrentSelection() {
      return fetch(resolveEndpoint + '?ids=' + encodeURIComponent(blockId))
        .then(function(r) { return r.ok ? r.json() : null; })
        .then(function(result) {
          var entry = result && result.success && result.data && result.data[blockId];
          return entry ? { id: entry.id, feedName: entry.feedName } : null;
        })
        .catch(function() { return null; });
    }

    function fetchFeeds(query, limit) {
      var url = listEndpoint + '?limit=' + limit + (query ? '&q=' + encodeURIComponent(query) : '');
      return fetch(url, { method: 'GET', headers: { 'Content-Type': 'application/json' } })
        .then(function(r) { return r.ok ? r.json() : Promise.reject(new Error('status ' + r.status)); });
    }

    function openList() {
      if (isOpen) return;
      isOpen = true;
      listEl.hidden = false;
      searchInput.setAttribute('aria-expanded', 'true');
      caret.textContent = '▲';
    }

    function closeList() {
      if (!isOpen) return;
      isOpen = false;
      listEl.hidden = true;
      searchInput.setAttribute('aria-expanded', 'false');
      searchInput.removeAttribute('aria-activedescendant');
      caret.textContent = '▼';
      activeIndex = -1;
    }

    function setActive(index) {
      var items = listEl.querySelectorAll('[role="option"]');
      if (!items.length) return;
      if (index < 0) index = items.length - 1;
      if (index >= items.length) index = 0;
      activeIndex = index;
      for (var i = 0; i < items.length; i++) {
        var on = i === index;
        items[i].setAttribute('aria-selected', on ? 'true' : 'false');
        items[i].style.background = on ? '#f1f1f1' : 'transparent';
        if (on) {
          searchInput.setAttribute('aria-activedescendant', items[i].id);
          // Keep the highlighted row inside the scrollable panel.
          if (items[i].offsetTop < listEl.scrollTop) {
            listEl.scrollTop = items[i].offsetTop;
          } else if (items[i].offsetTop + items[i].offsetHeight > listEl.scrollTop + listEl.clientHeight) {
            listEl.scrollTop = items[i].offsetTop + items[i].offsetHeight - listEl.clientHeight;
          }
        }
      }
    }

    function selectFeed(feed) {
      current = { id: feed.id, feedName: feed.feedName };
      searchInput.value = feed.feedName;
      closeList();
      saveSelection(feed.id);
    }

    function renderMessage(text) {
      listEl.innerHTML = '';
      var li = document.createElement('li');
      li.textContent = text;
      li.style.cssText = 'padding: 10px 12px; font-size: 13px; color: #6d7175;';
      listEl.appendChild(li);
      options = [];
      activeIndex = -1;
    }

    function renderOptions(feeds, hasMore, query) {
      // Keep the saved feed reachable even when it falls outside these results,
      // so the picker never looks like nothing is selected.
      var list = feeds.slice();
      if (current && !query && !list.some(function(f) { return f.id === current.id; })) {
        list.unshift({ id: current.id, feedName: current.feedName, videoCount: null });
      }
      options = list;

      if (hasOverride) {
        hint.textContent = 'A Feed ID override is set under Advanced and is taking priority. Clear it to use this picker.';
      } else if (hasMore) {
        hint.textContent = 'More feeds match — keep typing to narrow it down.';
      } else {
        hint.textContent = 'Choose a feed, then click Save in the theme editor.';
      }

      if (!list.length) {
        renderMessage(query ? 'No feeds match "' + query + '"' : 'No feeds — create one in the app');
        return;
      }

      listEl.innerHTML = '';
      list.forEach(function(feed, i) {
        var li = document.createElement('li');
        li.id = 'feed-opt-' + blockId + '-' + i;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', 'false');
        li.style.cssText = 'display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 10px; border-radius: 6px; cursor: pointer; font-size: 14px; color: #202223;';

        var name = document.createElement('span');
        name.textContent = feed.feedName;
        name.style.cssText = 'overflow: hidden; text-overflow: ellipsis; white-space: nowrap;';
        if (current && feed.id === current.id) name.style.fontWeight = '600';
        li.appendChild(name);

        var meta = document.createElement('span');
        meta.textContent = current && feed.id === current.id
          ? 'Selected'
          : (feed.videoCount == null ? '' : feed.videoCount + ' videos');
        meta.style.cssText = 'flex: none; font-size: 12px; color: #6d7175;';
        li.appendChild(meta);

        li.addEventListener('mouseenter', function() { setActive(i); });
        // mousedown, not click: the input's blur would close the list first.
        li.addEventListener('mousedown', function(e) { e.preventDefault(); selectFeed(feed); });

        listEl.appendChild(li);
      });
      activeIndex = -1;
    }

    function runSearch(query) {
      // Late responses from a slower earlier keystroke must not overwrite a
      // newer result.
      var seq = ++searchSeq;
      openList();
      fetchFeeds(query, query ? SEARCH_SIZE : PAGE_SIZE)
        .then(function(result) {
          if (seq !== searchSeq) return;
          if (!result.success) throw new Error(result.error || 'Search failed');
          renderOptions(result.data || [], result.hasMore, query);
        })
        .catch(function(err) {
          if (seq !== searchSeq) return;
          renderMessage('Error: ' + err.message);
        });
    }

    function loadFeeds() {
      loadCurrentSelection().then(function(sel) {
        current = sel;
        if (sel) searchInput.value = sel.feedName;
        if (hasOverride) {
          hint.textContent = 'A Feed ID override is set under Advanced and is taking priority. Clear it to use this picker.';
        }
      });

      searchInput.addEventListener('focus', function() {
        this.select();
        runSearch('');
      });

      searchInput.addEventListener('input', function() {
        var query = this.value.trim();
        clearTimeout(searchTimer);
        // Debounced so typing doesn't fire a proxy request per keystroke.
        searchTimer = setTimeout(function() { runSearch(query); }, 300);
      });

      searchInput.addEventListener('keydown', function(e) {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          if (!isOpen) { runSearch(this.value.trim()); return; }
          setActive(activeIndex + (e.key === 'ArrowDown' ? 1 : -1));
        } else if (e.key === 'Enter') {
          if (isOpen && activeIndex >= 0 && options[activeIndex]) {
            e.preventDefault();
            selectFeed(options[activeIndex]);
          }
        } else if (e.key === 'Escape') {
          closeList();
          // Typing then escaping shouldn't leave a half-typed name in the box.
          if (current) this.value = current.feedName;
        }
      });

      // Clicking anywhere else dismisses the panel.
      document.addEventListener('mousedown', function(e) {
        if (!combo.contains(e.target)) {
          closeList();
          if (current) searchInput.value = current.feedName;
        }
      });
    }
    if (shop) loadFeeds();
  })();
  </script>
{% endif %}

<script>
  window.__video_cart_config__ = window.__video_cart_config__ || {};
  window.__video_cart_config__.store_page = '{{ store_page }}';
</script>

{% comment %}
  Rendered unconditionally now: the runtime resolves the feed from data-block-id
  when no override is set. Previously a blank feed_id produced no DOM at all, so
  nothing can regress. The bundle is loaded once by the app embed.
{% endcomment %}
<div class="video-cart-container"
     data-block-id="{{ block.id }}"
     data-feed-id="{{ block.settings.feed_id | strip }}"
     data-container-id="video-carousel-{{ block.id }}"
     data-shop="{{ shop.permanent_domain }}"
     {% if request.design_mode %}data-design-mode="true"{% endif %}
     {{ block.shopify_attributes }}>
  <div id="video-carousel-{{ block.id }}"></div>
</div>
