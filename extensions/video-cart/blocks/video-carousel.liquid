{% schema %}
{
  "name": "Video Carousel",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "feed_id",
      "label": "Feed ID",
      "info": "Select a feed in the dropdown below (theme editor), then Save."
    }
  ]
}
{% endschema %}

{% assign store_page = 'other' %}
{% if template.name == 'index' %}
  {% assign store_page = 'homePage' %}
{% elsif template.name == 'product' %}
  {% assign store_page = 'productPage' %}
{% elsif template.name == 'collection' %}
  {% assign store_page = 'collectionPage' %}
{% endif %}


{% comment %} Theme editor: feed selector dropdown only {% endcomment %}
{% if request.design_mode %}
  <div class="video-feed-selector" style="padding: 16px; background: #f6f6f7; border: 1px dashed #d1d5db; border-radius: 8px; margin-bottom: 16px;">
    <label for="feed-select-{{ block.id }}" style="display: block; font-size: 13px; font-weight: 600; color: #202223; margin-bottom: 8px;">Select Video Feed</label>
    <select id="feed-select-{{ block.id }}" style="width: 100%; padding: 8px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 14px; background: white;">
      <option value="">Loading feeds...</option>
    </select>
    <p id="feed-hint-{{ block.id }}" style="margin: 8px 0 0; font-size: 12px; color: #6d7175;">Copy the selected Feed ID into the "Feed ID" setting in the sidebar, then Save.</p>
  </div>

  <script>
  (function() {
    var blockId = '{{ block.id }}';
    var shop = '{{ shop.permanent_domain }}';
    var currentFeedId = '{{ block.settings.feed_id }}'.trim();
    var select = document.getElementById('feed-select-' + blockId);
    var hint = document.getElementById('feed-hint-' + blockId);

    function loadFeeds() {
      fetch('apps/video-widget/feeds/list', { method: 'GET', headers: { 'Content-Type': 'application/json' } })
        .then(function(r) { return r.ok ? r.json() : Promise.reject(new Error('status ' + r.status)); })
        .then(function(result) {
          if (!result.success || !result.data || !result.data.length) {
            select.innerHTML = '<option value="">No feeds — create one in the app</option>';
            select.disabled = true;
            return;
          }
          select.innerHTML = '<option value="">— Select a feed —</option>';
          result.data.forEach(function(feed) {
            var opt = document.createElement('option');
            opt.value = feed.id;
            opt.textContent = feed.feedName + ' (' + (feed.videoCount || 0) + ' videos)';
            if (feed.id === currentFeedId) opt.selected = true;
            select.appendChild(opt);
          });
          select.disabled = false;
          select.addEventListener('change', function() {
            var id = this.value;
            hint.textContent = id
              ? 'Copy "' + id + '" into the Feed ID setting in the sidebar, then Save.'
              : 'Copy the selected Feed ID into the "Feed ID" setting in the sidebar, then Save.';
          });
        })
        .catch(function(err) {
          select.innerHTML = '<option value="">Error: ' + err.message + '</option>';
          select.disabled = true;
        });
    }
    if (shop) loadFeeds();
  })();
  </script>
{% endif %}

<script>
  window.__video_cart_config__ = window.__video_cart_config__ || {};
  window.__video_cart_config__.store_page = '{{ store_page }}';
</script>

{% comment %} Storefront: single div with feed/widget id; widget handles the rest {% endcomment %}
{% if block.settings.feed_id != blank %}
  <div class="video-cart-container"
       data-feed-id="{{ block.settings.feed_id }}"
       data-container-id="video-carousel-{{ block.id }}"
       data-shop="{{ shop.permanent_domain }}">
    <div id="video-carousel-{{ block.id }}" data-widget-id="{{ block.settings.feed_id  }}" ></div>
  </div>
  <script src="{{ 'bundle-video-cart.iife.js' | asset_url }}" defer></script>
{% else %}
  {% if request.design_mode %}
    <div style="padding: 40px; text-align: center; background: #f6f6f7; border: 2px dashed #d1d5db; border-radius: 8px; color: #6d7175;">
      <p style="font-size: 14px; font-weight: 600; margin: 0;">No feed selected</p>
      <p style="font-size: 13px; margin: 8px 0 0;">Select a feed above, copy its ID into Feed ID, then Save.</p>
    </div>
  {% endif %}
{% endif %}
