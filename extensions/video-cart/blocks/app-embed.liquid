
{% schema %}
{
  "name": "Video Cart",
  "target": "head"
}
{% endschema %}

{%- liquid
  # shop.brand and either logo can be nil. Nil property lookups are safe, but
  # image_url raises when it cannot resolve a dimension, hence the guard.
  # square_logo is Shopify's documented "preferred logo for square UI elements";
  # logo is the fallback for merchants who only filled the wide one.
  assign vc_brand_logo = shop.brand.square_logo
  unless vc_brand_logo
    assign vc_brand_logo = shop.brand.logo
  endunless
  assign vc_brand_logo_url = ''
  if vc_brand_logo
    assign vc_brand_logo_url = vc_brand_logo | image_url: width: 96, height: 96, crop: 'center'
  endif
-%}

<script>
  // Set app URL - this should be your app's public URL
  // You can set this via environment variable or app metafield
  window.__video_cart_app_url__ = window.__video_cart_app_url__ || 
    {% if app.metafields.app_url %}
      {{ app.metafields.app_url | json }};
    {% else %}
      null; // Set this manually: window.__video_cart_app_url__ = 'https://your-app-url.com';
    {% endif %}
  
  window.__video_cart_config__ = {
    shop: {{ shop.permanent_domain | json }},
    brand: {
      name: {{ shop.name | json }},
      logoUrl: {{ vc_brand_logo_url | json }}
    },
    enabled: {{ block.settings.enabled | json }},
    isActive: true,
    position: 'video-carousel',
    currency: {{ shop.currency | json }}
  };
</script>

{% comment %}
  hls.js fetches segments in CORS mode, so the stream preconnect MUST carry
  `crossorigin` — a non-CORS preconnect opens a separate connection-pool entry
  and the warmed socket goes unused. Poster images load as plain <img> and CSS
  backgrounds, so image.mux.com must NOT have it, for the same reason inverted.

  Only the master playlist and the images are covered: the variant playlist and
  the media segments come from region-specific *.fastly.mux.com hosts that are
  not known until the master playlist has been fetched and parsed, so they still
  pay a full handshake. This is a real win for posters and a marginal one for
  video start — warming the playlist itself is what would fix that.

  dns-prefetch is the fallback for browsers that ignore preconnect.
{% endcomment %}
<link rel="preconnect" href="https://stream.mux.com" crossorigin>
<link rel="preconnect" href="https://image.mux.com">
<link rel="dns-prefetch" href="https://stream.mux.com">
<link rel="dns-prefetch" href="https://image.mux.com">

<script src="{{ 'bundle-video-cart.iife.js' | asset_url }}" defer></script>


