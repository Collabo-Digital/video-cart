// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Session {
  session_id          String    @id @default(auto()) @map("_id") @db.ObjectId
  id                  String    @unique
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  shopId             String?
  shopDomain         String    @unique
  name               String?
  email              String?
  contactEmail       String?
  customerEmail      String?
  shopOwner          String?
  accessToken        String
  
  // Plan Info
  planName           String?
  planDisplayName    String?
  partnerDevelopment Boolean   @default(false)
  shopifyPlus        Boolean   @default(false)
  
  // Timestamps
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  shopCreatedAt      DateTime?
  
  // App specific
  isActive           Boolean   @default(true)
  installedAt        DateTime  @default(now())
  uninstalledAt      DateTime?
  
  // Relations
  feeds              Feed[]
}

model Video {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String?
  serviceProvider String   @default("mux")
  videoUploadId   String   @unique
  videoAssetId    String   @unique
  videoPlaybackId String?
  status          String   @default("PROCESSING")
  duration        Float?
  aspectRatio     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Relations
  feedVideos      FeedVideo[]
  videoAnalytics VideoAnalytics[]
}

model Feed {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  widgetId       String      @unique @default(uuid())
  feedName       String
  shopDomain     String
  widgetType     String      @default("carousel") // carousel | grid
  isEnabled      Boolean     @default(true)
  isDeleted      Boolean     @default(false)
  
  // Settings
  autoplay       Boolean     @default(false)
  showControls   Boolean     @default(true)
  showTitle      Boolean     @default(true)
  // Structured settings: { general: {}, design: {}, translation: {} }
  // - general: options from General accordion (extensible)
  // - design: design/display options (extensible)
  // - translation: UI strings (carouselTitle, carouselDescription, addToCartText, etc.)
  settings       Json?
  
  // Timestamps
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  
  // Relations
  shop            Shop             @relation(fields: [shopDomain], references: [shopDomain], onDelete: Cascade)
  videos          FeedVideo[]
  feedAnalytics   FeedAnalytics[]
  videoAnalytics  VideoAnalytics[]

  @@index([shopDomain])
  @@index([isDeleted])
}

// Junction table for Feed-Video many-to-many relationship
model FeedVideo {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  feedId          String   @db.ObjectId
  videoId         String  
  playbackId      String
  
  // Product tagging: array of product objects (id, title, handle, image, etc.) as JSON
  productsTagged  Json     @default("[]")
  
  // Order in feed
  position        Int      @default(0)
  
  // Timestamps
  addedAt         DateTime @default(now())
  
  // Relations
  feed            Feed     @relation(fields: [feedId], references: [id], onDelete: Cascade)
  video           Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  
  @@unique([feedId, videoId])
  @@index([feedId])
  @@index([videoId])
}

// Feed-level analytics: one row per feed per day (UTC date)
model FeedAnalytics {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  feedId      String   @db.ObjectId
  date        DateTime // UTC start-of-day

  impressions Int      @default(0)
  views       Int      @default(0)
  clicks      Int      @default(0)
  purchases   Int      @default(0)
  sales       Float    @default(0)

  extras      Json?

  feed        Feed     @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@unique([feedId, date])
  @@index([date])
}

// Video-in-feed analytics: one row per (video, feed) per day
model VideoAnalytics {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  videoId        String   @db.ObjectId
  feedId         String   @db.ObjectId
  date           DateTime // UTC start-of-day

  impressions    Int      @default(0)
  views         Int      @default(0)
  clicks        Int      @default(0)
  purchases     Int      @default(0)
  sales         Float    @default(0)
  totalWatchTime Float    @default(0) // seconds
  avgWatchTime   Float?

  extras         Json?

  video         Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  feed          Feed     @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@unique([videoId, feedId, date])
  @@index([date])
}