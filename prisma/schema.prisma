// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Session {
  session_id          String    @id @default(auto()) @map("_id") @db.ObjectId
  id                  String    @unique
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model Shop {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  shopId        String?
  shopDomain    String  @unique
  name          String?
  email         String?
  contactEmail  String?
  customerEmail String?
  shopOwner     String?

  // Plan Info
  planName           String?
  planDisplayName    String?
  // Shop currency (e.g. "USD", "EUR") — populated at auth; UI formats money
  // with this instead of a hardcoded "$".
  currencyCode       String?
  partnerDevelopment Boolean @default(false)
  shopifyPlus        Boolean @default(false)
  shopOwnerName  String?
  shopAddress1   String?
  shopAddress2   String?
  shopCity       String?
  shopProvince   String?
  shopZip        String?
  shopCountry    String?
  shopLatitude   Float?
  shopLongitude  Float?
  shopPhone      String?

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  shopCreatedAt DateTime?

  // App specific
  isActive      Boolean   @default(true)
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  appPlan       String?
  crispObject   Json?
  planLimits    Json?
  // Opened by an authenticated "Configure in theme" click. /blocks/assign is a
  // storefront-reachable write, and app-proxy signing only proves the request
  // came through this shop — not that it came from staff. This window is what
  // stops an anonymous visitor remapping a block's feed.
  themeSetupUntil DateTime?
  globalSettings  GlobalSettings?
  // videoViewLimit Int?
  // videoViewCount Int?
  // videoUploadLimit Int? 
  // videoViewLimitReached Boolean? @default(false)

  // Relations
  feeds               Feed[]
  videos              Video[]
  feedVideos          FeedVideo[]
  feedAnalytics       FeedAnalytics[]
  videoAnalytics      VideoAnalytics[]
  videoCartOrderItems VideoCartOrderItem[]
  themeBlockFeeds     ThemeBlockFeed[]
}

model GlobalSettings {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  shopDomain String   @unique
  settings   Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  shop       Shop     @relation(fields: [shopDomain], references: [shopDomain], onDelete: Cascade)
}

model Video {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String?
  shopDomain      String
  // Display name: user can update. Falls back to fileUploadName if not set.
  fileName        String?
  // Original name at upload/import; never updated. Used for duplicate detection.
  fileUploadName  String?
  serviceProvider String   @default("mux")
  videoUploadId   String   @unique
  videoAssetId    String   @unique
  videoPlaybackId String?
  status          String   @default("PROCESSING")
  duration        Float?
  aspectRatio     String?
  // Soft delete: retiring a video must NOT cascade-destroy its historical
  // VideoAnalytics rows (which would retroactively change past reports).
  isDeleted       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  feedVideos     FeedVideo[]
  videoAnalytics VideoAnalytics[]
  shop           Shop             @relation(fields: [shopDomain], references: [shopDomain], onDelete: Cascade)

  @@index([fileUploadName])
  @@index([shopDomain, isDeleted])
  @@index([shopDomain])
}

model Feed {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  widgetId   String  @unique @default(uuid())
  feedName   String
  shopDomain String
  widgetType String  @default("carousel") // carousel | grid
  template    String  @default("default")
  widgetPage      String  @default("homePage") // homepage | productPage | collectionPage | custom
  customPagePath  String?
  isEnabled  Boolean @default(true)
  isDeleted  Boolean @default(false)

  // Settings
  autoplay     Boolean @default(false)
  showControls Boolean @default(true)
  showTitle    Boolean @default(true)
  // Structured settings: { general: {}, design: {}, translation: {} }
  // - general: options from General accordion (extensible)
  // - design: design/display options (extensible)
  // - translation: UI strings (carouselTitle, carouselDescription, addToCartText, etc.)
  settings     Json?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  shop           Shop             @relation(fields: [shopDomain], references: [shopDomain], onDelete: Cascade)
  videos         FeedVideo[]
  feedAnalytics  FeedAnalytics[]
  videoAnalytics VideoAnalytics[]

  @@index([shopDomain])
  @@index([isDeleted])
}

// Junction table for Feed-Video many-to-many relationship
model FeedVideo {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  feedId     String @db.ObjectId
  videoId    String @db.ObjectId
  playbackId String
  shopDomain String

  // Product tagging: array of product objects (id, title, handle, image, etc.) as JSON
  productsTagged Json @default("[]")

  // Order in feed
  position Int @default(0)

  // Timestamps
  addedAt DateTime @default(now())

  // Relations
  feed  Feed  @relation(fields: [feedId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  shop  Shop  @relation(fields: [shopDomain], references: [shopDomain], onDelete: Cascade)

  @@unique([feedId, videoId])
  @@index([feedId])
  @@index([videoId])
  @@index([shopDomain])
}

// Feed-level analytics: one row per feed per day (UTC date)
model FeedAnalytics {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  feedId     String   @db.ObjectId
  date       DateTime // UTC start-of-day
  shopDomain String

  // Widget-level analytics (per requirements)
  widgetImpressions   Int   @default(0) // widget loaded + visible
  widgetClicks        Int   @default(0) // widget clicks / interactions
  widgetVideoPlays    Int   @default(0) // video plays initiated from widget
  widgetViews         Int   @default(0) // (optional stored) clicks + video plays
  widgetProductClicks Int   @default(0) // product clicks from widget
  widgetAddToCart     Int   @default(0) // add-to-cart events attributed to widget
  widgetOrders        Int   @default(0) // completed checkouts attributed to widget
  widgetRevenue       Float @default(0) // revenue from widget-driven purchases

  extras    Json?
  isDeleted Boolean @default(false)

  feed Feed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopDomain], references: [shopDomain], onDelete: Cascade)

  @@unique([feedId, date])
  @@index([date])
  @@index([isDeleted])
  @@index([shopDomain])
  // Serves the shop-wide analytics reads: equality on shopDomain + range on date.
  @@index([shopDomain, date])
}

// Video-in-feed analytics: one row per (video, feed) per day
model VideoAnalytics {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  videoId            String   @db.ObjectId
  feedId             String   @db.ObjectId
  date               DateTime // UTC start-of-day
  shopDomain         String
  // Video-level analytics (per requirements)
  videoImpressions   Int      @default(0) // video visible in widget
  videoViews         Int      @default(0) // video views (play events)
  videoProductClicks Int      @default(0) // product click count per video
  videoAtcClicks     Int      @default(0) // ATC button clicks for tagged products
  videoAddToCart     Int      @default(0) // add-to-cart events attributed to video
  videoOrders        Int      @default(0) // completed checkouts attributed to video
  videoRevenue       Float    @default(0) // revenue attributed to video

  extras    Json?
  isDeleted Boolean @default(false)

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  feed  Feed  @relation(fields: [feedId], references: [id], onDelete: Cascade)
  shop  Shop  @relation(fields: [shopDomain], references: [shopDomain], onDelete: Cascade)

  @@unique([videoId, feedId, date])
  @@index([date])
  @@index([isDeleted])
  @@index([shopDomain])
  // Serves the shop-wide analytics reads: equality on shopDomain + range on date.
  @@index([shopDomain, date])
  // findByFeedAndDateRange filters on feedId, which is NOT the prefix of
  // @@unique([videoId, feedId, date]) — so that index cannot serve it.
  @@index([feedId, date])
}

// Orders that had at least one line item attributed to the video-cart widget (from pixel).
// totalRevenue = sum of line_total for those items only (not full Shopify order total).
model VideoCartOrder {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  shopDomain   String
  orderId      String // Shopify order GID e.g. gid://shopify/Order/123 — unique per shop, not globally
  orderNumber  String? // display number e.g. #1001
  totalRevenue Float    @default(0) // sum of line_total for app-attributed items only
  currency     String?
  createdAt    DateTime @default(now())

  items VideoCartOrderItem[]

  // Per-shop uniqueness: a globally-unique orderId let one shop overwrite
  // another shop's order via the public conversion endpoint.
  @@unique([shopDomain, orderId])
  @@index([shopDomain])
  @@index([shopDomain, createdAt])
}

// One row per line item that had _tracking (video_id + widget_id).
model VideoCartOrderItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String   @db.ObjectId
  feedId     String   @db.ObjectId
  videoId    String   @db.ObjectId
  shopDomain String
  productId  String?
  variantId  String?
  lineItemId String? // Shopify line item id (from orders/create webhook) — enables exact refund matching
  visitorId  String? // anonymous vdcrt_visitor id — click-to-order audit trail
  quantity   Int      @default(1)
  lineTotal  Float    @default(0)
  createdAt  DateTime @default(now())
  isDeleted  Boolean  @default(false)

  order VideoCartOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop  Shop           @relation(fields: [shopDomain], references: [shopDomain], onDelete: Cascade)

  @@index([orderId])
  @@index([feedId])
  @@index([videoId])
  @@index([feedId, isDeleted])
  @@index([shopDomain])
}

// Server-side ATC attribution intent, keyed by Shopify cart token. The
// orders/create webhook joins on payload.cart_token — nothing is written into
// the cart or order itself, so nothing shows in the merchant's order admin.
model CartAttribution {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  shopDomain String
  cartToken  String
  productId  String
  variantId  String?
  feedId     String   @db.ObjectId
  videoId    String   @db.ObjectId
  quantity   Int      @default(1)
  visitorId  String?
  createdAt  DateTime @default(now())

  // Repeat ATC of the same product+video+feed in the same cart updates
  // quantity instead of stacking rows.
  @@unique([shopDomain, cartToken, productId, feedId, videoId])
  @@index([shopDomain, cartToken])
  @@index([createdAt])
}

// Which feed a given theme app block renders.
//
// Keyed by Shopify's block id, which is stable in the theme's template JSON.
// This exists because a theme block setting cannot be written by JavaScript —
// the schema is static and the theme-editor channel is one-directional — so the
// merchant's choice is stored here instead of in the theme.
model ThemeBlockFeed {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  shopDomain String
  blockId    String
  feedId     String   @db.ObjectId
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  shop Shop @relation(fields: [shopDomain], references: [shopDomain], onDelete: Cascade)

  // One feed per block: re-picking overwrites instead of accumulating rows.
  @@unique([shopDomain, blockId])
  @@index([shopDomain])
}
